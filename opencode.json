{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["local_agent"],
  "default_agent": "build",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "local_agent": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local model host",
      "options": {
        "baseURL": "http://127.0.0.1:{env:PORT}/v1",
        "apiKey": "local",
        "timeout": 300000
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "websearch": "allow",
    "webfetch": "allow"
  },
  "compaction": {"auto": true, "prune": true},
  "watcher": {"ignore": ["**/models/**", "**/llama-cpp/**", "**/.opencode-runtime/**"]}
}
